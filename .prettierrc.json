{
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "embeddedLanguageFormatting": "off",
    "overrides": [
        {
            "files": ["*.json", ".prettierrc.json"],
            "options": { "tabWidth": 4 }
        }
    ]
}
